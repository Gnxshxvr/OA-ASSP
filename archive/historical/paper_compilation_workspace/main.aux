\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces RequiredCapture versus workload size $Q$. A ratio above the break-even line ($1.0$) means the decision costs more than the entire oracle gap. Library inference stays overhead-bound at every checkpoint after amortization; compiled inference enters the viable zone and reaches $0.2898$ at $Q=500$.}}{6}{}\protected@file@percent }
\newlabel{fig:req_cap}{{3}{6}{}{figure.3}{}}
